# Names only — never put real credentials in this file.
# Copy to .env.local (gitignored) and fill values.

# Client + server (publishable key only — safe for the browser, RLS-enforced)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. NEVER referenced from client code, NEVER committed.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Server-only bearer secret protecting /api/cron/* handlers
CRON_SECRET=<random-string>

# Server-only: powers the in-app Budapest research assistant. Optional locally;
# the UI fails clearly when absent. Never prefix either variable with NEXT_PUBLIC_.
OPENAI_API_KEY=<openai-api-key>
OPENAI_SEARCH_MODEL=gpt-5-mini
