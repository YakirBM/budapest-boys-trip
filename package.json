{
  "name": "budapest-boys-trip",
  "version": "0.1.0",
  "private": true,
  "description": "Budapest 2026 Trip Companion PWA — Hebrew RTL, offline-first, Supabase-backed",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "prebuild": "node scripts/build-sw-manifest.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
